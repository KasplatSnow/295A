# ---------- DEV HOSTS / PORTS ----------
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000

AI_HOST=127.0.0.1
AI_PORT=8001

UI_PORT=5000

# ---------- URLs (computed or used directly) ----------
AI_BASE_INTERNAL=http://127.0.0.1:8001
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_INTERNAL_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_EXTERNAL_URL=http://127.0.0.1:8888
MTX_WEBRTCADDITIONALHOSTS=

# ---------- FRONTEND (Vite) ----------
# IMPORTANT: Only VITE_* values are exposed in the client bundle.
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_ENABLE_WEBRTC=false
VITE_WEBRTC_VIEWER_BASE_URL=
VITE_HLS_VIEWER_BASE_URL=
VITE_ALLOW_LOOPBACK_WEBRTC_ON_WINDOWS=false
VITE_ENABLE_MEDIAMTX_API_HEALTHCHECK=true

# ---------- NGINX / EDGE ----------
# Use host:port values (without scheme). In single-VM compose these stay internal.
NGINX_BACKEND_UPSTREAM=backend:8000
NGINX_AI_UPSTREAM=ai:8080

# ---------- DJANGO ----------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=postgresql://vigilzone:vigilzone@localhost:5432/vigilzone
CHANNEL_LAYER_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=
REDIS_PORT=6379
AI_REDIS_URL=redis://redis:6379/0
AI_REDIS_HOST=
AI_REDIS_PORT=6379
AI_USE_REDIS_PUBLISH=1
AI_INCIDENT_CHANNEL=vigilzone.ai.incidents
MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554
RELAY_RTSP_HOST=127.0.0.1
RELAY_RTSP_PORT=8554
AI_AUTO_REGISTER_WEBHOOK=0
AI_CONFIG_SNAPSHOT_MODE=backend_only
DEFAULT_AI_TENANT_ID=
STRICT_SERVICE_URL_VALIDATION=0
ALLOW_LOCALHOST_SERVICE_URLS=1

# ---------- STREAM PREVIEW (OpenCV + MJPEG) ----------
STREAM_PREVIEW_FPS=5
STREAM_PREVIEW_MAX_WIDTH=960
STREAM_PREVIEW_JPEG_QUALITY=70
STREAM_IDLE_TTL_SECONDS=60
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;3000000
STREAM_PREVIEW_PREFER_AI_SNAPSHOTS=1
STREAM_PREVIEW_RTSP_FALLBACK_ENABLED=0
STREAM_PREVIEW_AI_SNAPSHOT_TIMEOUT_SECONDS=2.0
MEDIAMTX_WRITE_QUEUE_SIZE=2048

# ---------- AI SERVICE ----------
AI_API_PORT=8001
AI_PUBLIC_BASE_URL=http://127.0.0.1:8001
AI_CORS_ALLOWED_ORIGINS=*
AI_EVIDENCE_DIR=
AI_DATA_DIR=
AI_STAGING_DIR=
AI_ENROLL_IMAGE_DIR=
