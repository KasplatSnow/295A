DJANGO_DEBUG=1
DATABASE_URL=postgresql://vigilzone:vigilzone@localhost:5432/vigilzone
CHANNEL_LAYER_BACKEND=redis

# Local backend/dev default: external Docker Redis with auth.
# Swap to REDIS_URL=redis://redis:6379/0 when running fully inside compose.
REDIS_URL=redis://default:redispw@localhost:32768/0
REDIS_HOST=
REDIS_PORT=6379
AI_INCIDENT_CHANNEL=vigilzone.ai.incidents
AI_AUTO_REGISTER_WEBHOOK=0
AI_CONFIG_SNAPSHOT_MODE=backend_only

# AI & MediaMTX Integration
AI_BASE_INTERNAL=http://127.0.0.1:8001

# MediaMTX Provisioning
# Control-plane URL used by backend/reconciler to manage relay paths.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_INTERNAL_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_EXTERNAL_URL=http://127.0.0.1:8888

# Optional YAML fallback (only if API is unreachable)
# In local dev, set this to your mediamtx.yml path
MEDIAMTX_CONFIG_PATH=C:\tools\mediamtx.yml

# RTSP base for backend/AI relay consumers.
MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554
RELAY_RTSP_HOST=127.0.0.1
RELAY_RTSP_PORT=8554
STRICT_SERVICE_URL_VALIDATION=0
ALLOW_LOCALHOST_SERVICE_URLS=1
MEDIA_ROOT=

STREAM_PREVIEW_FPS=3
STREAM_PREVIEW_MAX_WIDTH=960
STREAM_PREVIEW_JPEG_QUALITY=70
STREAM_IDLE_TTL_SECONDS=60
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;3000000
STREAM_PREVIEW_PREFER_AI_SNAPSHOTS=1
STREAM_PREVIEW_RTSP_FALLBACK_ENABLED=0
STREAM_PREVIEW_AI_SNAPSHOT_TIMEOUT_SECONDS=2.0
