# .gitignore for CCTV AI Module

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/*.csv

# Evidence (generated at runtime)
evidence/**/*.jpg
evidence/**/*.mp4
evidence/**/*.png

# Alerts (generated at runtime)
alerts/*.jsonl

# OS
.DS_Store
Thumbs.db

# Model weights (too large for git)
*.pt
*.pth
*.onnx
*.engine

# Runtime data (generated at runtime)
data/entities.db
data/entities.db-shm
data/entities.db-wal
data/embeddings/*
data/enroll_images/*
data/staging_uploads/*
!data/embeddings/.gitkeep
!data/enroll_images/.gitkeep
!data/staging_uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Temporary files
*.tmp
*.temp

# Archives
*.zip

# Runtime-cloned repos (auto-fetched by Doctor at startup)
# Keep third_party/beats source files (BEATs.py, Tokenizers.py) tracked
# but ignore everything in Paper-AnyAnomaly and similar cloned repos.
third_party/Paper-AnyAnomaly/
# BEATs vendored source IS tracked (no wildcard exclusion for third_party/beats/)

# Audio model weights (large, download separately — see models/audio/beats/README.md)
models/audio/beats/*.pt
models/audio/beats/*.pth

# Audio evidence clips (generated at runtime)
evidence/audio/
